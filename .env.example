# ── Copy to .env and fill in real values ─────────────────────────────────────
# Never commit .env to source control

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="FakeNews Detector"
APP_VERSION="1.0.0"
DEBUG=false
API_PREFIX="/api/v1"

# ── Security — CHANGE THESE IN PRODUCTION ────────────────────────────────────
SECRET_KEY="your-super-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
# Local:      postgresql+asyncpg://postgres:postgres@localhost:5432/fakenews
# Docker:     postgresql+asyncpg://postgres:postgres@postgres:5432/fakenews
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fakenews

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ── ML model ─────────────────────────────────────────────────────────────────
CLASSIFIER_MODEL_NAME=roberta-base
CLASSIFIER_MODEL_PATH=models/fakenews_roberta
EMBEDDER_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
MAX_SEQ_LENGTH=512
INFERENCE_BATCH_SIZE=8
# "cuda" if you have a GPU, "cpu" otherwise
DEVICE=cpu
# Set true on very small hosts to skip heavyweight model/embedder startup.
LIGHTWEIGHT_MODE=false

# ── FAISS ────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=models/faiss_index/articles.index
FAISS_METADATA_PATH=models/faiss_index/metadata.json
EMBEDDING_DIM=768
TOP_K_EVIDENCE=5

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false   # set to true in production
